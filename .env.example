PORT=5001
# Development database (docker compose up -d db exposes it on host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/payment_reconciliation
# Used only when RUN_DB_TESTS=true. The name MUST end with "_test": the tests wipe the tables.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/payment_reconciliation_test
